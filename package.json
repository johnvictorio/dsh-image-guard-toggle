{
  "name": "dsh-image-guard-toggle",
  "version": "1.2.0",
  "description": "DSH plugin with a session-header button that toggles the dsh-llm-pi-ai request image-size guard (maxRequestImageBytes) on the configured provider route, live and without restart.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "image-guard",
    "settings"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  }
}
